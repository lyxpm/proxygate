# 数据目录
PG_DATA_DIR=./data

# 管理后台监听地址。默认只绑定回环地址。
PG_ADMIN_LISTEN=127.0.0.1:8080

# 首次启动的管理员密码。留空则生成随机密码并写入 data/initial-admin-password.txt。
PG_ADMIN_PASSWORD=

# 会话有效期（Go duration）。
PG_SESSION_TTL=24h

# 可选：允许应用节点使用回环地址（默认禁止；私网 RFC1918 地址始终允许）。
# PG_ALLOW_LOOPBACK_UPSTREAM=false

# 可选：base64 编码的 32 字节主密钥，用于加密 DNS API 凭据。
# 不设置时自动生成 data/config/master.key。
# PG_MASTER_KEY=

# 可信反向代理（逗号分隔 IP/CIDR）。只有来自这些地址的 X-Forwarded-For 会被采信。
PG_TRUSTED_PROXIES=

# 管理后台 IP 白名单（逗号分隔 IP/CIDR）。留空允许所有来源。
# Docker 健康检查来自 127.0.0.1，启用白名单时请包含它。
PG_ADMIN_ALLOW_CIDRS=

# 私有 ACME CA 的 PEM 证书文件（step-ca、Pebble 等）。留空使用系统信任链。
PG_ACME_CA_FILE=

# 开发模式：输出 SQL 调试日志。
PG_DEV=false
